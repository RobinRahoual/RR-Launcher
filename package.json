{
  "name": "rr-launcher",
  "productName": "RR Launcher",
  "version": "1.29.2",
  "description": "Launcher pour jeux PC",
  "author": "Robin Rahoual",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "release": "electron-builder --win nsis --x64 --publish always",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "fr.robinrahoual.rrlauncher",
    "productName": "RR Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "node_modules/node-hid/**",
      "node_modules/pkg-prebuilds/**",
      "node_modules/7z-wasm/**",
      "src/features/emu/extract-*.js"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RR Launcher"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RobinRahoual",
        "repo": "RR-Launcher",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8",
    "node-hid": "^3.4.0"
  },
  "repository": "https://github.com/RobinRahoual/RR-Launcher"
}
